# Format read by scripts/wolfram.sh and scripts/zulip.sh (they parse this file with grep/sed; it is NOT sourced):
#   - one KEY=value per line, at the start of the line (an optional leading "export " is accepted)
#   - the value may be wrapped in one pair of double quotes; nothing else is stripped
#   - no inline comments and no trailing spaces or CRLF line endings: they become part of the value
#   - only the first matching line per key is used; real environment variables take precedence
# Copy to .env and fill in. Never commit .env.
# Wolfram Alpha LLM API app id (used by scripts/wolfram.sh, exploration only).
# Get one at https://products.wolframalpha.com/llm-api/
WOLFRAM_LLM_APP_ID=
# Fallback if WOLFRAM_LLM_APP_ID is unset
WOLFRAM_APP_ID=
# Optional: used only by scripts/zulip.sh for read-only access to the Lean Zulip.
ZULIP_SITE=
ZULIP_EMAIL=
ZULIP_API_KEY=
