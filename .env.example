# Copy to .env and fill in. Never commit .env.
# Wolfram Alpha LLM API app id (used by scripts/wolfram.sh, exploration only).
# Get one at https://products.wolframalpha.com/llm-api/
WOLFRAM_LLM_APP_ID=
# Fallback if WOLFRAM_LLM_APP_ID is unset
WOLFRAM_APP_ID=
# Optional: used only by scripts/zulip.sh for read-only access to the Lean Zulip.
ZULIP_SITE=
ZULIP_EMAIL=
ZULIP_API_KEY=
